,"requestId","operation","sourceId","targetQuestionCode"],"type":"object"},{"additionalProperties":false,"properties":{"reason":{"minLength":1,"type":"string"},"scope":{"enum":["DIALOGUE","SAFETY"],"type":"string"},"sourceId":{"minLength":1,"type":"string"},"targetId":{"minLength":1,"type":"string"},"type":{"enum":["RESUME"],"type":"string"}},"required":["type","scope","targetId","sourceId","reason"],"type":"object"}]},"minItems":1,"type":"array"}},"required":["events"],"type":"object"},{"type":"null"}]}},"required":["updates","request"],"type":"object"},"strict":true},"type":"function"},{"function":{"description":"현재 자료로 원래 자동사고를 평가할 때 Assessor 후보를 요청한다. 네 영역 채움이나 사용자 초안 명령을 요구하지 않는다.","name":"assess_completion","parameters":{"additionalProperties":false,"properties":{"reason":{"minLength":1,"type":"string"},"sourceIds":{"items":{"minLength":1,"type":"string"},"minItems":0,"type":"array"},"updates":{"anyOf":[{"additionalProperties":false,"properties":{"events":{"items":{"anyOf":[{"additionalProperties":false,"properties":{"note":{"minLength":1,"type":"string"},"questionCode":{"minLength":1,"type":"string"},"sourceId":{"minLength":1,"type":"string"},"status":{"enum":["ANSWERED","NONE","SKIPPED","REOPEN"],"type":"string"},"type":{"enum":["GOAL"],"type":"string"}},"required":["type","questionCode","status","sourceId","note"],"type":"object"},{"additionalProperties":false,"properties":{"instructionQuote":{"minLength":1,"type":"string"},"occurrence":{"anyOf":[{"minimum":0,"type":"integer"},{"type":"null"}]},"operation":{"enum":["RETRACT","REAFFIRM"],"type":"string"},"sourceId":{"minLength":1,"type":"string"},"targetQuote":{"anyOf":[{"minLength":1,"type":"string"},{"type":"null"}]},"targetSourceId":{"minLength":1,"type":"string"},"type":{"enum":["CORRECTION"],"type":"string"}},"required":["type","operation","targetSourceId","targetQuote","occurrence","sourceId","instructionQuote"],"type":"object"},{"additionalProperties":false,"properties":{"kind":{"enum":["EXAMPLE","EXP