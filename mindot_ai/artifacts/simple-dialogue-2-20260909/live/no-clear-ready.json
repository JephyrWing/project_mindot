      "dialogueState": {
        "sources": [
          {
            "sourceRef": "s_00000001",
            "questionRef": null,
            "text": "검토 중 보고서 오류 한 곳을 지적받았다.",
            "current": true,
            "withdrawnRanges": []
          },
          {
            "sourceRef": "s_00000002",
            "questionRef": null,
            "text": "이번 보고서의 표 합계에 오류 한 곳이 있었다.",
            "current": true,
            "withdrawnRanges": []
          },
          {
            "sourceRef": "s_00000003",
            "questionRef": "q_00000002",
            "text": "표의 합계 한 곳이 원자료와 달랐고 직접 대조해 확인했다.",
            "current": true,
            "withdrawnRanges": []
          },
          {
            "sourceRef": "s_00000004",
            "questionRef": "q_00000003",
            "text": "그 합계가 맞았다는 반대 사실은 없다.",
            "current": true,
            "withdrawnRanges": []
          },
          {
            "sourceRef": "s_00000005",
            "questionRef": "q_00000004",
            "text": "원자료와 합계가 다르다는 사실에 대한 다른 설명은 떠오르지 않는다.",
            "current": true,
            "withdrawnRanges": []
          },
          {
            "sourceRef": "s_00000006",
            "questionRef": "q_00000001",
            "text": "이번 표 합계에 오류 한 곳이 있었다는 범위까지만 말할 수 있고, 다른 일이나 내 전체 능력에 대한 판단은 아니다.",
            "current": true,
            "withdrawnRanges": []
          }
        ],
