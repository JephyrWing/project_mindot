{
  "contractVersion": "cbt-insight-1",
  "tools": [
    {
      "name": "ask_question",
      "description": "사용자가 지금 바로 답할 수 있는 맥락상 CBT 질문 하나를 표시한다. 활성 제안 뒤 새 정정·철회·재탐색이면 기존 제안을 제거하고 대화로 돌아간다.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "name": "offer_help",
      "description": "직전 CBT 질문 또는 현재 제안을 쉬운 말이나 중립적인 가상 예시로 설명한다. 활성 제안은 보존하며 사용자 동의나 저장을 확정하지 않는다.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "name": "assess_completion",
      "description": "사용자가 초기 판단의 잘못을 알아차리고 수정했을 때 AFTER와 유형 후보를 작성한다.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      }
    },
    {
      "name": "respond_control",
      "description": "질문을 멈추고 기존 이어하기·완전 종료 버튼을 안내한다.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      }
    },
    {
      "name": "respond_safety",
      "description": "명확한 현재 즉시 위험은 STOP, 현재성·주체 등 필요한 사실이 불분명할 때만 CLARIFY. 이미 명시한 위험을 반복 확인하지 않는다.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "CLARIFY",
              "STOP"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "action",
          "reason"
        ]
      }
    }
  ],
  "assessorOutput": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "beforeCorrection": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "evidence": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "messageNumber": {
                    "type": "integer"
                  },
                  "quote": {
                    "type": "string"
                  }
                },
                "required": [
                  "messageNumber",
                  "quote"
                ]
              }
            },
            "required": [
              "text",
              "evidence"
            ]
          }
        ]
      },
      "afterText": {
        "type": [
          "string",
          "null"
        ]
      },
      "afterEvidence": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "messageNumber": {
              "type": "integer"
            },
            "quote": {
              "type": "string"
            }
          },
          "required": [
            "messageNumber",
            "quote"
          ]
        }
      },
      "assessmentType": {
        "type": "string",
        "enum": [
          "DISTORTION_SUGGESTED",
          "NO_CLEAR_DISTORTION",
          "UNDETERMINED"
        ]
      },
      "suggestions": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "ALL_OR_NOTHING_THINKING",
                "CATASTROPHIZING_FORTUNE_TELLING",
                "DISQUALIFYING_DISCOUNTING_POSITIVE",
                "EMOTIONAL_REASONING",
                "LABELING",
                "MAGNIFICATION_MINIMIZATION",
                "MENTAL_FILTER_SELECTIVE_ABSTRACTION",
                "MIND_READING",
                "OVERGENERALIZATION",
                "PERSONALIZATION",
                "SHOULD_MUST_STATEMENTS",
                "TUNNEL_VISION"
              ]
            },
            "explanation": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "explanation"
          ]
        }
      },
      "comparisonExplanation": {
        "type": "string"
      },
      "evidenceForText": {
        "type": [
          "string",
          "null"
        ]
      },
      "evidenceAgainstText": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "beforeCorrection",
      "afterText",
      "afterEvidence",
      "assessmentType",
      "suggestions",
      "comparisonExplanation",
      "evidenceForText",
      "evidenceAgainstText"
    ]
  },
  "assessmentReviewOutput": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "accept": {
        "type": "boolean"
      },
      "reason": {
        "type": "string"
      }
    },
    "required": [
      "accept",
      "reason"
    ]
  },
  "serverOnlyRules": [
    "nonempty displayed text and maximum 500 characters",
    "offer_help preserves an active proposal; ask_question clears it",
    "non-null afterText requires USER evidence",
    "null afterText -> empty evidence and suggestions + UNDETERMINED; not approvable",
    "NO_CLEAR_DISTORTION or UNDETERMINED -> suggestions empty",
    "DISTORTION_SUGGESTED -> at least one unique existing code",
    "evidence quote is substring of the referenced USER content",
    "proposalId/revision/phase/assessment eligibility semantics are not model-generated ledgers"
  ]
}
